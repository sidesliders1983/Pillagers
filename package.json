{
  "name": "pillagers-world",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:lan": "vite --host 0.0.0.0 --port 5175 --strictPort",
    "build": "node scripts/validate-public-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4175 --strictPort",
    "test": "node --test tests/*.test.mjs",
    "assets:optimize": "node scripts/asset-pipeline.mjs optimize",
    "assets:publish": "node scripts/asset-pipeline.mjs publish",
    "assets:test": "node scripts/asset-pipeline.mjs test",
    "validate:characters": "node scripts/validate-characters.mjs",
    "assets:registry": "node scripts/update-character-registry.mjs",
    "validate:style": "node scripts/validate-character-style.mjs",
    "assets:human-modules": "node scripts/prepare-meshy-modules.mjs",
    "assets:human": "node scripts/prepare-meshy-human.mjs",
    "assets:houses": "node scripts/prepare-meshy-houses.mjs",
    "assets:terrain": "node scripts/prepare-terrain-assets.mjs",
    "assets:islands": "node scripts/prepare-campaign-islands.mjs",
    "assets:character-sources": "node scripts/prepare-character-sources.mjs",
    "validate:public": "node scripts/validate-public-assets.mjs",
    "assets:tent": "node scripts/prepare-meshy-tent.mjs",
    "assets:cow": "node scripts/prepare-meshy-cow.mjs",
    "assets:livestock": "node scripts/prepare-livestock.mjs"
  },
  "dependencies": {
    "nosleep.js": "0.12.0",
    "simplex-noise": "4.0.3",
    "three": "0.187.0",
    "three.quarks": "0.16.0",
    "quarks.core": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "jsdom": "26.1.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "meshoptimizer": "0.22.0"
  }
}
